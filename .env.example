# Copy to .env and adjust. .env is git-ignored; keep this file current when you add a variable.

# PostgreSQL (docker-compose.yml). Host port 5433 avoids clashing with a locally installed Postgres.
POSTGRES_USER=brimline
POSTGRES_PASSWORD=brimline_dev_only
POSTGRES_DB=brimline
POSTGRES_PORT=5433
DATABASE_URL=postgresql://brimline:brimline_dev_only@localhost:5433/brimline

# Engine service (FastAPI)
ENGINE_PORT=8000
ENGINE_URL=http://localhost:8000

# Web app (Next.js)
WEB_PORT=3000

# AI provider key, first used in M2. Model names live in config/, not here.
# ANTHROPIC_API_KEY=
