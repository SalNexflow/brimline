# Copy to .env and adjust (`make setup` does this and generates SESSION_SECRET).
# .env is git-ignored; keep this file current when you add a variable.

# PostgreSQL (docker-compose.yml). Host port 5433 avoids clashing with a locally installed Postgres.
# POSTGRES_USER is the owner role: it runs migrations and the seed, and owns every table.
POSTGRES_USER=brimline
POSTGRES_PASSWORD=brimline_dev_only
POSTGRES_DB=brimline
POSTGRES_PORT=5433
DATABASE_OWNER_URL=postgresql://brimline:brimline_dev_only@localhost:5433/brimline

# The engine's runtime role. It must be brimline_app; migrations create it with this password
# and grant it only what each table needs (it cannot change the schema or the audit log).
DATABASE_URL=postgresql://brimline_app:brimline_app_dev_only@localhost:5433/brimline

# Engine service (FastAPI)
ENGINE_PORT=8000
ENGINE_URL=http://localhost:8000

# Session tokens are signed with this secret (at least 32 characters). `make setup` replaces the
# placeholder with a random value in your .env.
SESSION_SECRET=replace-me-with-at-least-32-random-characters
SESSION_TTL_MINUTES=480

# Demo login (pick a seeded user, no password). Keep it off for any deployment (M11).
DEMO_LOGIN=true

# Web app (Next.js)
WEB_PORT=3000

# Model calls (M2). AI_MODE: live (real API), fake (prepared replies, used by tests), or off
# (quotes start empty and staff fill them in). Model names and prices live in config/models.toml.
AI_MODE=live
# ANTHROPIC_API_KEY=
